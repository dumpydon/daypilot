# Optional: DayPilot uses a deterministic local reasoner when this is blank.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional public web research. General answers do not require this key.
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# Optional observability. The application works without LangSmith.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=daypilot-local
# Optional secret-free monotonic stage timings for latency diagnostics.
DAYPILOT_TIMING_LOGS=false

# Local default. Render production should use its managed PostgreSQL URL.
DATABASE_URL=sqlite:///./data/daypilot.db
DAYPILOT_DATABASE_CONNECT_TIMEOUT_SECONDS=10
DAYPILOT_TIMEZONE=Asia/Kolkata
DAYPILOT_DEMO_MODE=true
DAYPILOT_PUBLIC_DEMO_MODE=false
DAYPILOT_ADMIN_SECRET=
DAYPILOT_ADMIN_SESSION_TTL_SECONDS=28800
DAYPILOT_SITE_URL=http://localhost:3000
# JSON array; add the deployed Cloudflare origin in Render production.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://daypilot.dumpydon.workers.dev"]

# Connected mode defaults to Composio-managed auth. DAYPILOT_DEMO_MODE=true always
# wins and keeps every capability on the seeded local runtime.
DAYPILOT_PROVIDER_MODE=managed
# Optional per-capability overrides: demo, managed, direct, or unavailable.
# DAYPILOT_MAIL_PROVIDER=managed
# DAYPILOT_CALENDAR_PROVIDER=managed
# DAYPILOT_TASKS_PROVIDER=managed
# DAYPILOT_FILES_PROVIDER=local
# DAYPILOT_X_PROVIDER=managed

# One server-only Composio project key for the normal managed connection path.
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=
COMPOSIO_GOOGLE_TOOLKIT=googlesuper
COMPOSIO_X_TOOLKIT=twitter
COMPOSIO_CALLBACK_URL=http://localhost:8000/api/connections/managed/callback

# Advanced direct-provider OAuth clients (optional; never use NEXT_PUBLIC_*).
# These are not needed for the normal managed path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connections/google/callback
GOOGLE_TASK_LIST_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/connections/x/callback

# Local backend credential encryption. A key file is generated with mode 600 when absent.
DAYPILOT_CREDENTIAL_STORE_PATH=data/daypilot.credentials.enc
DAYPILOT_CREDENTIAL_KEY_FILE=data/.daypilot-credential.key
DAYPILOT_PROVIDER_HTTP_TIMEOUT_SECONDS=15
DAYPILOT_LOCAL_FILE_MAX_BYTES=1000000
DAYPILOT_LOCAL_FILE_MAX_RESULTS=25
DAYPILOT_LOCAL_FILE_MAX_DEPTH=4
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
